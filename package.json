{
  "name": "@openclaw-plugins/split-view",
  "version": "0.1.0",
  "type": "module",
  "description": "Splits session view into chat, file-actions, and thinking panes with switchable layouts.",
  "license": "MIT",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "prepack": "npm run build",
    "validate": "openclaw plugins validate --entry ./dist/index.js"
  },
  "dependencies": {
    "typebox": "^1.3.34"
  },
  "devDependencies": {
    "typescript": "^7.0.0",
    "openclaw": ">=2026.3.24-beta.2"
  },
  "peerDependencies": {
    "openclaw": ">=2026.3.24-beta.2"
  },
  "openclaw": {
    "extensions": ["./dist/index.js"],
    "compat": {
      "pluginApi": ">=2026.3.24-beta.2",
      "minGatewayVersion": "2026.3.24-beta.2"
    },
    "build": {
      "openclawVersion": "2026.3.24-beta.2",
      "pluginSdkVersion": "2026.3.24-beta.2"
    }
  }
}
